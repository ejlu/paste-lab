{
  "name": "paste-lab",
  "version": "0.2.1",
  "description": "Compare displayed spreadsheet clipboard text with available stored cell values.",
  "keywords": ["clipboard", "paste", "spreadsheet", "google-sheets", "excel", "tsv", "data-import"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejlu/paste-lab.git",
    "directory": "packages/paste-lab"
  },
  "homepage": "https://ejlu.github.io/paste-lab/",
  "type": "module",
  "types": "./lib/compare.d.ts",
  "exports": {
    ".": {
      "types": "./lib/compare.d.ts",
      "import": "./lib/compare.js"
    },
    "./inventory": {
      "types": "./lib/inventory.d.ts",
      "import": "./lib/inventory.js"
    }
  },
  "files": ["lib/compare.js", "lib/compare.d.ts", "lib/parser.js", "lib/inventory.js", "lib/inventory.d.ts", "lib/column-preview.js", "lib/column-preview.d.ts", "LICENSE"],
  "scripts": {
    "prepack": "npm --prefix ../.. run build:lib"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": { "parse5": "8.1.1" }
}
