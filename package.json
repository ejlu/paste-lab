{
  "name": "paste-lab-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build --base=./",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "build:lib": "tsc -p tsconfig.library.json && node -e \"require('node:fs').copyFileSync('LICENSE', 'packages/paste-lab/LICENSE')\"",
    "pack:lib": "npm pack --workspace paste-lab",
    "test:package": "node test/package/run.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "parse5": "8.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "workspaces": [
    "packages/paste-lab"
  ]
}
