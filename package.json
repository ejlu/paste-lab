  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "parse5": "8.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
